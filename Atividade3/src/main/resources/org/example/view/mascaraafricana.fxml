<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="12.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controller.MascaraAfricanaController">
   <padding>
      <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
   </padding>
   <children>
      <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Máscaras africanas" />
      <GridPane hgap="10.0" vgap="8.0">
         <children>
            <Label text="Etnia" GridPane.columnIndex="0" GridPane.rowIndex="0" />
            <TextField fx:id="txtEtnia" prefWidth="260.0" promptText="Ex.: Songye" GridPane.columnIndex="1" GridPane.rowIndex="0" />
            <Label text="Material" GridPane.columnIndex="0" GridPane.rowIndex="1" />
            <TextField fx:id="txtMaterial" prefWidth="260.0" promptText="Ex.: madeira" GridPane.columnIndex="1" GridPane.rowIndex="1" />
            <Label text="Ano de criação" GridPane.columnIndex="0" GridPane.rowIndex="2" />
            <TextField fx:id="txtAno" prefWidth="260.0" promptText="Ex.: 1920" GridPane.columnIndex="1" GridPane.rowIndex="2" />
         </children>
      </GridPane>
      <Button mnemonicParsing="false" onAction="#cadastrar" text="Cadastrar máscara" />
      <Label text="Cadastrados (clique em um item para usar as ações abaixo):" />
      <ListView fx:id="lvMascaraAfricana" prefHeight="150.0" />
      <FlowPane hgap="14.0" vgap="8.0">
         <children>
            <HBox alignment="CENTER_LEFT" spacing="6.0">
               <children>
                  <Button mnemonicParsing="false" onAction="#calcularIdade" text="Calcular idade" />
               </children>
            </HBox>
            <HBox alignment="CENTER_LEFT" spacing="6.0">
               <children>
                  <Button mnemonicParsing="false" onAction="#verificarAntiga" text="É antiga?" />
               </children>
            </HBox>
            <HBox alignment="CENTER_LEFT" spacing="6.0">
               <children>
                  <Button mnemonicParsing="false" onAction="#descrever" text="Descrever" />
               </children>
            </HBox>
         </children>
      </FlowPane>
      <Label fx:id="lblMensagem" style="-fx-font-weight: bold;" wrapText="true" />
   </children>
</VBox>
