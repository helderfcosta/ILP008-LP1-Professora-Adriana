<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="12.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controller.TrilhaController">
   <padding>
      <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
   </padding>
   <children>
      <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Trilhas" />
      <GridPane hgap="10.0" vgap="8.0">
         <children>
            <Label text="Nome" GridPane.columnIndex="0" GridPane.rowIndex="0" />
            <TextField fx:id="txtNome" prefWidth="260.0" promptText="Ex.: Trilha da Mata" GridPane.columnIndex="1" GridPane.rowIndex="0" />
            <Label text="Extensão (km)" GridPane.columnIndex="0" GridPane.rowIndex="1" />
            <TextField fx:id="txtExtensao" prefWidth="260.0" promptText="Ex.: 12,5" GridPane.columnIndex="1" GridPane.rowIndex="1" />
            <Label text="Dificuldade (1 a 5)" GridPane.columnIndex="0" GridPane.rowIndex="2" />
            <TextField fx:id="txtDificuldade" prefWidth="260.0" promptText="Ex.: 3" GridPane.columnIndex="1" GridPane.rowIndex="2" />
         </children>
      </GridPane>
      <Button mnemonicParsing="false" onAction="#cadastrar" text="Cadastrar trilha" />
      <Label text="Cadastrados (clique em um item para usar as ações abaixo):" />
      <ListView fx:id="lvTrilha" prefHeight="150.0" />
      <FlowPane hgap="14.0" vgap="8.0">
         <children>
            <HBox alignment="CENTER_LEFT" spacing="6.0">
               <children>
                  <TextField fx:id="txtVelocidade" prefWidth="140.0" promptText="Velocidade (km/h)" />
                  <Button mnemonicParsing="false" onAction="#calcularTempo" text="Calcular tempo" />
               </children>
            </HBox>
            <HBox alignment="CENTER_LEFT" spacing="6.0">
               <children>
                  <Button mnemonicParsing="false" onAction="#classificar" text="Classificar" />
               </children>
            </HBox>
            <HBox alignment="CENTER_LEFT" spacing="6.0">
               <children>
                  <Button mnemonicParsing="false" onAction="#descrever" text="Descrever" />
               </children>
            </HBox>
         </children>
      </FlowPane>
      <Label fx:id="lblMensagem" style="-fx-font-weight: bold;" wrapText="true" />
   </children>
</VBox>
